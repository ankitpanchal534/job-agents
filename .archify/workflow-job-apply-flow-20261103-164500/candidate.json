  "cards": [
    {
      "dot": "violet",
      "title": "Job tracker (P1)",
      "items": [
        "One row per job, created the moment its link is found",
        "Stores link, company, summarised JD, match score, reasons, missing skills",
        "Status: new, rejected, watch-later, queued, blocked, applied, failed",
        "Updated at every stage, including applied or failed after submit",
        "Also blocks duplicate applications"
      ]
    },
    {
      "dot": "cyan",
      "title": "Answer resolver (P2)",
      "items": [
        "1. Direct field from the profile files",
        "2. Curated FAQ match, used verbatim",
        "3. Grounded LLM draft, queued for your review",
        "4. No supporting fact: block and notify",
        "Never generated: visa, salary, notice period, background, EEO"
      ]
    },
    {
      "dot": "emerald",
      "title": "Matcher decision (P3)",
      "items": [
        "Hard filters run first: location, seniority, salary, visa, blacklist, duplicates",
        "Score 75 or more goes to the apply queue",
        "Score 50 to 75 is kept as watch-later, with a reason",
        "Below 50 is rejected and logged"
      ]
    },
    {
      "dot": "rose",
      "title": "Human handoff (P4)",
      "items": [
        "Blocks: CAPTCHA, expired login, unknown question, unconfirmed submit",
        "Phone push with screenshot; the agent moves on to other jobs",
        "You resolve one job, then resume it"
      ]
    },
    {
      "dot": "amber",
      "title": "Reading the tags",
      "items": [
        "P1 to P4 are phases of the foundation plan",
        "later: discovery, applicant, email verification",
        "Guardrails now: matcher has no tools, domain allowlist"
      ]
    }
  ]
